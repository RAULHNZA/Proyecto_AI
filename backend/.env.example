# Groq se usa siempre para transcribir (Whisper) y, por defecto, para resúmenes y conclusión
GROQ_API_KEY="gsk_..."
# Llave de respaldo "Agente_planeacion": se usa automáticamente si la principal llega a su límite
GROQ_API_KEY_AGENTE_PLANEACION="gsk_..."
# Proveedor de resúmenes y conclusión: "groq" o "anthropic"
LLM_PROVIDER="groq"
# ANTHROPIC_API_KEY="sk-ant-..."
# Opcional: modelo (por defecto openai/gpt-oss-120b en Groq, claude-sonnet-5 en Anthropic)
# LLM_MODEL=""
# Opcional: modelo de transcripción (whisper-large-v3 o whisper-large-v3-turbo, más rápido y barato)
# WHISPER_MODEL="whisper-large-v3"
# Opcional: palabras acumuladas que disparan un resumen parcial (~8-10 min de reunión)
# SUMMARY_EVERY_WORDS="1200"
ALLOWED_ORIGINS="http://localhost:5173"
