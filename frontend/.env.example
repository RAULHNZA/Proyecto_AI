VITE_VAPI_PUBLIC_KEY="tu_vapi_public_key"
VITE_VAPI_ASSISTANT_ID="tu_vapi_assistant_id"
VITE_BACKEND_URL="http://localhost:8000"
# Opcional: "true" vuelve a mostrar la columna "Proyectos con IA"
# VITE_PROYECTOS_VISIBLES="true"
# Opcional: modelo con el que Vapi responde las preguntas (por defecto openai / gpt-4.1)
# VITE_VAPI_MODEL_PROVIDER="openai"
# VITE_VAPI_MODEL="gpt-4.1"
# Segunda etapa: muestra el botón Escuchar y la barra de escucha (por defecto oculto)
# VITE_ESCUCHA_HABILITADA="true"
